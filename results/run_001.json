{
  "run_id": "run_001",
  "date": "2026-06-12",
  "description": "Paper-exact Med-MoE reimplementation — corrected architecture + matched paper hyperparams (epochs 1/3/9, LR 2e-5, cosine schedule, weight_decay=0)",
  "config": {
    "model": {
      "llm": "HuggingFaceTB/SmolLM-135M-Instruct",
      "vision_encoder": "CLIP ViT-B/32 (openai, frozen) — paper uses CLIP-Large, simplified for 6GB VRAM",
      "projector": "MLP 512->576->576 (GELU)",
      "router": "Linear 576->4, reads mean-pooled T_comb (pre-LLM) — MLPx1, paper Fig.3 row b",
      "moe": {
        "num_experts": 4,
        "top_k": 2,
        "meta_expert": true,
        "intermediate_dim": 576,
        "gate_source": "frozen Router softmax output (eq. 4) — no learned per-layer gate"
      }
    },
    "data": {
      "dataset": "VQA-RAD + PathVQA",
      "total_samples": 200,
      "samples_per_class": 50,
      "classes": ["X-Ray", "CT", "MRI", "Pathology"],
      "max_length": 64
    },
    "training": {
      "phase1_epochs": 1,
      "phase2_epochs": 3,
      "phase3_epochs": 9,
      "batch_size": 2,
      "gradient_accumulation_steps": 4,
      "effective_batch_size": 8,
      "mixed_precision": "fp16",
      "phase1_lr": 1e-3,
      "phase2_lr": 2e-5,
      "phase3_lr": 2e-5,
      "scheduler": "cosine_with_warmup",
      "warmup_ratio": 0.1,
      "weight_decay": 0.0
    },
    "losses": {
      "phase1": "L_Align (LM CE)",
      "phase2": "L_Instr (LM CE) + L_Router (CE over domain labels)",
      "phase3": "L_MoE (LM CE)"
    },
    "trainable_params": {
      "phase1": "0.63M (projector only)",
      "phase2": "135.15M (LLM + router + projector)",
      "phase3": "149.30M (MoE experts + meta-expert)"
    },
    "deviations_from_paper": [
      "CLIP ViT-B/32 instead of CLIP-Large (VRAM constraint)",
      "hidden_dim=576 instead of paper's larger LLM hidden dim",
      "200 samples instead of ~500K (Phase 1) / ~10K (Phase 2-3)",
      "fp32 instead of bf16 (dtype compatibility)",
      "feature_select_layer not implemented (using final pooled output)"
    ]
  },
  "results": {
    "phase1": {
      "epochs": [
        {"epoch": 1, "lm_loss": 4.831}
      ],
      "final_lm_loss": 4.831
    },
    "phase2": {
      "epochs": [
        {"epoch": 1, "lm_loss": 4.393, "router_loss": 1.392, "router_acc": 0.250},
        {"epoch": 2, "lm_loss": 2.750, "router_loss": 1.392, "router_acc": 0.250},
        {"epoch": 3, "lm_loss": 2.272, "router_loss": 1.392, "router_acc": 0.250}
      ],
      "final_lm_loss": 2.272,
      "final_router_loss": 1.392,
      "final_router_acc": 0.250,
      "note": "Router stalled at uniform distribution (log(4)=1.386) — LR 2e-5 too small to learn domain signal from T_comb at 200 samples"
    },
    "phase3": {
      "epochs": [
        {"epoch": 1, "lm_loss": 12.920},
        {"epoch": 2, "lm_loss": 9.594},
        {"epoch": 3, "lm_loss": 7.460},
        {"epoch": 4, "lm_loss": 6.091},
        {"epoch": 5, "lm_loss": 5.276},
        {"epoch": 6, "lm_loss": 4.699},
        {"epoch": 7, "lm_loss": 4.355},
        {"epoch": 8, "lm_loss": 4.127},
        {"epoch": 9, "lm_loss": 4.040}
      ],
      "final_lm_loss": 4.040,
      "note": "Epoch 1 spike expected — MoE activation replaces all FFN layers with truncated weights. Slow recovery due to conservative LR 2e-5"
    }
